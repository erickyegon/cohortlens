# Local defaults work without any .env file. Override here if a port is taken or to export telemetry to the cloud.
POSTGRES_PASSWORD=cohortlens_local
COHORTLENS_READER_PASSWORD=reader_local
COHORTLENS_APP_PASSWORD=app_local
# Passwords end up in database URLs: use URL-safe characters only (letters, digits, - _ . ~)
DB_PORT=15432
# Set to 0.0.0.0 to expose the UI on your LAN (default: this machine only)
WEB_BIND=127.0.0.1
SERVICE_VERSION=dev
DEPLOYMENT_ENVIRONMENT=local
# Telemetry (wired in the observability epic): default is the local lgtm container
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
OTEL_EXPORTER_OTLP_HEADERS=
CHAOS_LATENCY_MS=0
