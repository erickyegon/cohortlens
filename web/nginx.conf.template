# Rendered at container start by the nginx image's template step (envsubst over the variables that are defined):
#   API_UPSTREAM  where /api/ is proxied to, e.g. http://api:8000 (Compose) or https://<api-service>.run.app (Cloud Run)
#   API_HOST      the Host header sent upstream (Cloud Run routes on it)
# NGINX_LOCAL_RESOLVERS is computed from /etc/resolv.conf (NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1, set in the Dockerfile).
# The upstream is a variable so nginx resolves it per request: Cloud Run addresses change and must not be pinned at start.
server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  location /api/ {
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
    set $api_upstream "${API_UPSTREAM}";
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api_upstream;
    proxy_ssl_server_name on;
    proxy_set_header Host ${API_HOST};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 15s;
  }

  location / {
    try_files $uri /index.html;
  }
}
