{
  "id": null,
  "uid": "cohortlens-core-journey",
  "title": "CohortLens core journey",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "cohortlens"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "dev,prod",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "dev",
            "value": "dev",
            "selected": false
          },
          {
            "text": "prod",
            "value": "prod",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Runs in the selected range",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "expr": "sum(increase(cohortlens_cohort_runs_total{environment=~\"$environment\"}[$__range]))",
          "legendFormat": "",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 2,
      "title": "Error rate (failed + timed out)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "expr": "sum(rate(cohortlens_cohort_runs_total{environment=~\"$environment\",outcome=~\"failed|timeout\"}[$__rate_interval])) / sum(rate(cohortlens_cohort_runs_total{environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Runs per second by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "expr": "sum by (outcome) (rate(cohortlens_cohort_runs_total{environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 4,
      "title": "Run duration p50 and p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cohortlens_cohort_run_duration_seconds_bucket{environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(cohortlens_cohort_run_duration_seconds_bucket{environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "p95 run duration by revision",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "expr": "histogram_quantile(0.95, sum by (le, revision) (rate(cohortlens_cohort_run_duration_seconds_bucket{environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "{{revision}}",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Error rate by revision",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "expr": "sum by (revision) (rate(cohortlens_cohort_runs_total{environment=~\"$environment\",outcome=~\"failed|timeout\"}[$__rate_interval])) / sum by (revision) (rate(cohortlens_cohort_runs_total{environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{revision}}",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Logs: failures and timeouts",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "__LOKI_UID__"
          },
          "editorMode": "code",
          "expr": "{service_name=\"cohortlens-api\", deployment_environment=~\"$environment\"} |~ \"failed|timed out|timeout|exception\""
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 8,
      "title": "Recent traces",
      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "__TEMPO_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "__TEMPO_UID__"
          },
          "queryType": "traceql",
          "limit": 20,
          "query": "{resource.service.name=\"cohortlens-api\" && resource.deployment.environment=~\"$environment\"}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      }
    }
  ]
}
